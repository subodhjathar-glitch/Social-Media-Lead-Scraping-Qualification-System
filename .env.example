# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_QUOTA_LIMIT=3330

# YouTube OAuth token (for auto-posting comments on Streamlit Cloud / cloud deploy)
# 1. Run locally:  python setup_youtube_oauth.py
# 2. Then run:     python export_oauth_token.py
# 3. Paste the printed YOUTUBE_TOKEN_JSON value here (and in Streamlit Cloud Secrets)
# YOUTUBE_TOKEN_JSON={"token":"ya29.xxx","refresh_token":"1//xxx","token_uri":"https://oauth2.googleapis.com/token","client_id":"xxx","client_secret":"xxx","scopes":["https://www.googleapis.com/auth/youtube.force-ssl"]}

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Supabase (backend for scraper + Streamlit dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_anon_public_key
# Use service role key so Streamlit can read all tables (bypasses RLS). Get from Supabase → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Allowed emails for app login (comma-separated). Internal use only.
# ALLOWED_EMAILS=subodh.jathar@gmail.com,durgesh.lokhande@gmail.com,yogavani.hathayoga@gmail.com

# Email Configuration
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient@example.com
EMAIL_PASSWORD=your_gmail_app_password

# Scraping Configuration
DAYS_BACK=7
MAX_VIDEOS_PER_CHANNEL=10
MAX_COMMENTS_PER_VIDEO=100

# Airtable (DEPRECATED - for migration only)
# AIRTABLE_TOKEN=your_airtable_token
# AIRTABLE_BASE_ID=your_base_id
